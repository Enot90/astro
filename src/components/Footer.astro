---
import Social from './Social.astro';

const username = 'withastro';
const socials = ['github', 'instagram', 'twitter', 'linkedIn'];
---

<footer>
  <p>
    Learn more about my projects on:{' '}
    {socials.map((social) => (
      <Social username={username} platform={social} />
    ))}
  </p>
</footer>

<style>
  footer {
    display: flex;
    gap: 1rem;
    margin-top: 2rem;
  }
</style>
